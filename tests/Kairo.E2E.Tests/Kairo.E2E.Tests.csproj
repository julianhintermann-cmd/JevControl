<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Kairo.E2E.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kairo.Windows\Kairo.Windows.csproj" />
    <ProjectReference Include="..\..\src\Kairo.BrowserHost\Kairo.BrowserHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Kairo.TestTargetApp\Kairo.TestTargetApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestSupport.cs" Link="Shared\TestSupport.cs" />
    <None Include="..\assets\e2e-contact-form.html" Link="assets\e2e-contact-form.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
