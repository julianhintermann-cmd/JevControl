<?xml version="1.0" encoding="utf-8"?>
<!--
  WixUI_KairoInstallDir – a copy of WixUI_InstallDir from WixToolset.UI.wixext 5.0.2
  (src/ext/UI/wixlib/WixUI_InstallDir.wxs, fragments "WixUI_InstallDir" + "WixUI_InstallDir_X64")
  with one extra dialog. All other dialogs (WelcomeDlg, LicenseAgreementDlg, InstallDirDlg,
  VerifyReadyDlg, Maintenance*, ExitDialog, ...) and their German texts come unchanged from the
  UI extension (culture de-DE).

  WixUI_InstallDir itself is declared with "file" access in the extension, so it cannot be
  referenced and patched; ui:WixUI would also add the X64 fragment with the original navigation.

  Install sequence:  WelcomeDlg -> LicenseAgreementDlg -> InstallDirDlg -> KairoOptionsDlg -> VerifyReadyDlg
  Changes compared to WixUI_InstallDir (marked "KAIRO" below):
    * InstallDirDlg  [Next] -> KairoOptionsDlg   (instead of VerifyReadyDlg)
    * KairoOptionsDlg [Back] -> InstallDirDlg, [Next] -> VerifyReadyDlg
    * VerifyReadyDlg [Back] -> KairoOptionsDlg   (first install; maintenance/patch unchanged)
    * ExitDialog: optional checkbox "Kairo jetzt starten" runs KairoLaunchApp (WixShellExec)
  The platform specific part (DoAction WixUIValidatePath_X64 / WixUIPrintEula_X64) is included
  directly because the package is x64 only.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="WixUI_KairoInstallDir">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <!-- InstallDirDlg / BrowseDlg edit the directory named by this property. -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- From WixUI_InstallDir_X64 -->
      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />

      <!-- From WixUI_InstallDir -->
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <!-- KAIRO: was Value="VerifyReadyDlg" -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="KairoOptionsDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <!-- KAIRO: new dialog between InstallDirDlg and VerifyReadyDlg -->
      <Publish Dialog="KairoOptionsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="KairoOptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <!-- KAIRO: was Value="InstallDirDlg" -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="KairoOptionsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />

      <!-- KAIRO: "Kairo jetzt starten" on the last page (standard WixUI ExitDialog optional checkbox).
           The checkbox is only shown on a first install/upgrade ("NOT Installed"). -->
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Kairo jetzt starten" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="[INSTALLFOLDER]Kairo.exe" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="KairoLaunchApp" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <ProgressText Action="KairoUninstallCleanup" Message="Kairo-Daten werden bereinigt" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>

  <Fragment>
    <UI>
      <!-- Layout and texts follow InstallDirDlg (banner dialog, 370 x 270). -->
      <Dialog Id="KairoOptionsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Legen Sie fest, wie [ProductName] eingerichtet werden soll." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Optionen" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="62" Width="330" Height="18"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="&amp;Desktop-Verknüpfung erstellen" />
        <Control Id="AutostartCheckBox" Type="CheckBox" X="20" Y="88" Width="330" Height="18"
                 Property="AUTOSTART" CheckBoxValue="1"
                 Text="Kairo beim Windows-Start &amp;automatisch starten" />
        <Control Id="AutostartHint" Type="Text" X="36" Y="107" Width="314" Height="30" NoPrefix="yes"
                 Text="Kairo startet dann unauffällig im Hintergrund. Sie können das später in den Einstellungen von Kairo ändern." />
      </Dialog>
    </UI>
  </Fragment>
</Wix>
