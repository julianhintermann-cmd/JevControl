<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <RootNamespace>Kairo.BrowserHost</RootNamespace>
    <AssemblyName>Kairo.BrowserHost</AssemblyName>
    <Description>Native messaging host of Kairo (Chrome, Edge, Firefox, Zen): relays messages between the Kairo extension and the Kairo desktop app.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BridgeProtocol.cs" Link="BridgeProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="com.kairo.bridge.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="com.kairo.bridge.firefox.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
