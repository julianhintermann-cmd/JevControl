<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Kairo.App.Controls">

  <!-- ============================================================ typography -->
  <FontFamily x:Key="Kairo.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Kairo.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Kairo.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Kairo.Text.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font.Display}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Kairo.Text.Subtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Kairo.Text.BodyStrong" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Kairo.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Kairo.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Kairo.Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text.Secondary}" />
  </Style>
  <Style x:Key="Kairo.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Kairo.Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Implicit text defaults -->
  <Style TargetType="TextBlock" BasedOn="{StaticResource Kairo.Text.Body}" />

  <!-- ============================================================ focus visual -->
  <Style x:Key="Kairo.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="7" RadiusY="7" StrokeThickness="2" Stroke="{DynamicResource Kairo.Focus}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ cards -->
  <Style x:Key="Kairo.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Kairo.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Card.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="Kairo.Card.Solid" TargetType="Border" BasedOn="{StaticResource Kairo.Card}">
    <Setter Property="Background" Value="{DynamicResource Kairo.Card.Solid}" />
  </Style>

  <!-- ============================================================ buttons -->
  <Style x:Key="Kairo.Button" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Control.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Control.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="c:Ui.CornerRadius" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}"
                  SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Icon" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource Kairo.IconFont}" FontSize="14"
                         Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Control.FillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Control.FillPressed}" />
              <Setter Property="Foreground" Value="{DynamicResource Kairo.Text.Secondary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Kairo.Text.Disabled}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Kairo.Button}" />

  <Style x:Key="Kairo.Button.Accent" TargetType="Button" BasedOn="{StaticResource Kairo.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Accent.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}" SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Icon" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource Kairo.IconFont}" FontSize="14"
                         Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Kairo.Button.Danger" TargetType="Button" BasedOn="{StaticResource Kairo.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Danger}" />
  </Style>

  <Style x:Key="Kairo.Button.Subtle" TargetType="Button" BasedOn="{StaticResource Kairo.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style x:Key="Kairo.Button.Icon" TargetType="Button" BasedOn="{StaticResource Kairo.Button.Subtle}">
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="32" />
  </Style>

  <Style x:Key="Kairo.Button.Link" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Accent.Foreground}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Caption buttons of the custom title bar -->
  <Style x:Key="Kairo.Button.Caption" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource Kairo.IconFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Nav.Selected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Kairo.Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource Kairo.Button.Caption}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ text input -->
  <Style x:Key="Kairo.TextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Kairo.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Control.FillInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Control.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <TextBlock x:Name="Placeholder" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{DynamicResource Kairo.Text.Tertiary}"
                         Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         FontSize="{TemplateBinding FontSize}" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="Wrap" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Kairo.Accent}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Control.FillHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Control.FillInputFocused}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Kairo.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Kairo.TextBox}" />

  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Kairo.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Control.FillInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Control.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="c:Ui.TrackPassword" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <TextBlock x:Name="Placeholder" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{DynamicResource Kairo.Text.Tertiary}"
                         Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center" />
              <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Kairo.Accent}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.HasText" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Control.FillInputFocused}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ check box / toggle switch / radio -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                    Background="{DynamicResource Kairo.Control.Fill}" BorderBrush="{DynamicResource Kairo.Control.StrokeStrong}">
              <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource Kairo.IconFont}" FontSize="12" Foreground="{DynamicResource Kairo.Accent.Text}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Kairo.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kairo.Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Kairo.ToggleSwitch" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True" />
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="State" Text="Aus" Foreground="{DynamicResource Kairo.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,52,0" HorizontalAlignment="Right" />
              <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Right"
                      Background="{DynamicResource Kairo.Control.Fill}" BorderBrush="{DynamicResource Kairo.Control.StrokeStrong}">
                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Kairo.Text.Secondary}" HorizontalAlignment="Left" Margin="4,0,0,0" />
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Kairo.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Kairo.Accent}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Kairo.Accent.Text}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
              <Setter TargetName="State" Property="Text" Value="Ein" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Width" Value="14" />
              <Setter TargetName="Knob" Property="Height" Value="14" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Outer" Width="20" Height="20" StrokeThickness="1" Stroke="{DynamicResource Kairo.Control.StrokeStrong}" Fill="{DynamicResource Kairo.Control.Fill}" />
            <Ellipse x:Name="Inner" Width="8" Height="8" Fill="{DynamicResource Kairo.Accent.Text}" Visibility="Collapsed" />
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Kairo.Accent}" />
              <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Kairo.Accent}" />
              <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ scroll bars -->
  <Style x:Key="Kairo.ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="3" Background="{DynamicResource Kairo.Scroll.Thumb}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource Kairo.ScrollThumb}" Margin="1,2" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="1" />
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb Style="{StaticResource Kairo.ScrollThumb}" Margin="2,1" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ progress bar (thin, Fluent style) -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Divider}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
            <Border x:Name="PART_Track" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
            <Border x:Name="Indeterminate" Width="120" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5" Visibility="Collapsed">
              <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="-120" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Run">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-120" To="760" Duration="0:0:1.4">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Run" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ combo box -->
  <Style x:Key="Kairo.ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="Transparent">
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Kairo.IconFont}" FontSize="10" Foreground="{DynamicResource Kairo.Text.Secondary}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <Grid>
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Kairo.Accent}" HorizontalAlignment="Left" Margin="-8,0,0,0" Visibility="Collapsed" />
              <ContentPresenter />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Nav.Selected}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Nav.Selected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Control.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Control.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,5,34,5" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" />
            <ToggleButton Style="{StaticResource Kairo.ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
            <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="10,0,34,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                     Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource Kairo.Text}" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide" VerticalOffset="4">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource Kairo.Card.Solid}" BorderBrush="{DynamicResource Kairo.Control.Stroke}" BorderThickness="1" CornerRadius="8" Padding="0,4" Margin="8,0,8,12">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.22" Direction="270" />
                </Border.Effect>
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Control.FillHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ navigation list (settings) -->
  <Style x:Key="Kairo.NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Kairo.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <Grid>
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Kairo.Accent}" HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed" />
              <ContentPresenter />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Nav.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Nav.Selected}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Kairo.NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Kairo.NavItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="Kairo.PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Kairo.NavItem}">
          <Setter Property="Padding" Value="12,10" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ tooltip / context menu -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Card.Solid}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kairo.Control.Stroke}" />
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Kairo.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Kairo.Card.Solid}" BorderBrush="{DynamicResource Kairo.Control.Stroke}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="240" Margin="0,0,12,12">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.25" Direction="270" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource Kairo.Divider}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Kairo.IconFont}" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
                <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Kairo.Text.Secondary}" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Kairo.IconFont}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" HorizontalOffset="4">
              <Border Background="{DynamicResource Kairo.Card.Solid}" BorderBrush="{DynamicResource Kairo.Control.Stroke}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="260" Margin="0,0,12,12">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.25" Direction="270" />
                </Border.Effect>
                <StackPanel IsItemsHost="True" />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Kairo.Nav.Selected}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Kairo.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ slider (minimal) -->
  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource Kairo.Accent}" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid MinHeight="24">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Kairo.Control.StrokeStrong}" Opacity="0.4" VerticalAlignment="Center" />
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{DynamicResource Kairo.Accent}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="4">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="20" Height="20">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Ellipse Fill="{DynamicResource Kairo.Card.Solid}" Stroke="{DynamicResource Kairo.Control.Stroke}" StrokeThickness="1" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Kairo.Accent}" />
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ settings rows -->
  <Style x:Key="Kairo.SettingRow" TargetType="Border" BasedOn="{StaticResource Kairo.Card}">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="64" />
  </Style>

  <Style x:Key="Kairo.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Kairo.Text.BodyStrong}">
    <Setter Property="Margin" Value="2,20,0,8" />
  </Style>

  <Style x:Key="Kairo.Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource Kairo.Accent.Subtle}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
